{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shopping.v1/request_refresh",
  "title": "request_refresh",
  "description": "",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "task_ref": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$"
    },
    "refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$"
      },
      "maxItems": 100
    },
    "kind": {
      "enum": [
        "offer",
        "seller",
        "certificate",
        "pre_approval_preview"
      ]
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$"
    },
    "expected_version": {
      "type": "integer",
      "minimum": 0
    },
    "cancellation_epoch": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "task_ref",
    "refs",
    "kind",
    "request_id",
    "expected_version",
    "cancellation_epoch"
  ],
  "x-tool-name": "request_refresh",
  "x-model-callable": true,
  "x-callers": [
    "model",
    "ui"
  ],
  "x-effect": "mutation",
  "x-response-schema": {
    "$ref": "common.schema.json#/$defs/envelope"
  }
}
