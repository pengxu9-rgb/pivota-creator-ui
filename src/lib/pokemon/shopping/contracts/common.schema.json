        },
        "grade_kind": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            {
              "type": "null"
            }
          ]
        },
        "grade_company": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            {
              "type": "null"
            }
          ]
        },
        "grade_value": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            {
              "type": "null"
            }
          ]
        },
        "condition_bucket": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            {
              "type": "null"
            }
          ]
        },
        "currency": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            {
              "type": "null"
            }
          ]
        },
        "seller_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            {
              "type": "null"
            }
          ]
        },
        "seller_name": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            {
              "type": "null"
            }
          ]
        },
        "source_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            {
              "type": "null"
            }
          ]
        },
        "source_url": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            {
              "type": "null"
            }
          ]
        },
        "url": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            {
              "type": "null"
            }
          ]
        },
        "availability": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            {
              "type": "null"
            }
          ]
        },
        "certificate_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            {
              "type": "null"
            }
          ]
        },
        "operation_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            {
              "type": "null"
            }
          ]
        },
        "order_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            {
              "type": "null"
            }
          ]
        },
        "merchant_order_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            {
              "type": "null"
            }
          ]
        },
        "forwarder_order_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            {
              "type": "null"
            }
          ]
        },
        "quote_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            {
              "type": "null"
            }
          ]
        },
        "selection_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            {
              "type": "null"
            }
          ]
        },
        "task_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            {
              "type": "null"
            }
          ]
        },
        "terms_hash": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            {
              "type": "null"
            }
          ]
        },
        "route": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            {
              "type": "null"
            }
          ]
        },
        "destination_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            {
              "type": "null"
            }
          ]
        },
        "subject": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            {
              "type": "null"
            }
          ]
        },
        "price_minor": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,11})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "item_minor": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,11})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "shipping_minor": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,11})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "fee_minor": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,11})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "tax_minor": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,11})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "total_minor": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,11})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "quantity": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "rating_value": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "rating_scale": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "review_count": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "state_version": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "operation_revision": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "observed_at": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "expires_at": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "synthetic": {
          "const": true
        },
        "source_permission": {
          "type": "boolean"
        },
        "physical_authenticity_verified": {
          "const": false
        },
        "matched_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "maxItems": 100
        }
      },
      "required": [
        "id",
        "kind",
        "synthetic"
      ]
    },
    "assumption": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "field": {
          "enum": [
            "currency",
            "budget_basis",
            "subject"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "label": {
          "enum": [
            "Assuming JPY item price · change",
            "Assuming Pikachu · change"
          ]
        },
        "confirmed": {
          "const": false
        }
      },
      "required": [
        "field",
        "value",
        "label",
        "confirmed"
      ]
    },
    "idempotency_key": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tenant": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$"
        },
        "app": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$"
        },
        "user": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$"
        },
        "task": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$"
        },
        "operation_type": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$"
        },
        "request_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$"
        }
      },
      "required": [
        "tenant",
        "app",
        "user",
        "task",
        "operation_type",
        "request_id"
      ]
    },
    "idempotency_entry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key": {
          "$ref": "#/$defs/idempotency_key"
        },
        "payload_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "operation_ref": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$"
        }
      },
      "required": [
        "key",
        "payload_hash",
        "operation_ref"
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,79}$"
        },
        "operation_ref": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "retry_class": {
          "enum": [
            "none",
            "read_refresh",
            "reconcile",
            "human_review"
          ]
        },
        "field_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$"
          },
          "maxItems": 100
        },
        "current_version": {
          "type": "integer",
          "minimum": 0
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$"
          },
          "maxItems": 100
        }
      },
      "required": [
        "code",
        "operation_ref",
        "retry_class",
        "field_refs",
        "current_version",
        "evidence_refs"
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "synthetic": {
          "const": true
        },
        "tool": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "task_ref": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$"
        },
        "state_version": {
          "type": "integer",
          "minimum": 0
        },
        "records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/record"
          },
          "maxItems": 100
        },
        "assumptions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/assumption"
          },
          "maxItems": 100
        },
        "operation_ref": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "original_text": {
          "type": "string",
          "maxLength": 2000
        }
      },
      "required": [
        "synthetic",
        "tool",
        "task_ref",
        "state_version",
        "records",
        "assumptions",
        "operation_ref",
        "status"
      ]
    },
    "envelope": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ok": {
              "const": true
            },
            "result": {
              "$ref": "#/$defs/result"
            }
          },
          "required": [
            "ok",
            "result"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ok": {
              "const": false
            },
            "error": {
              "$ref": "#/$defs/error"
            }
          },
          "required": [
            "ok",
            "error"
          ]
        }
      ]
    }
  },
  "x-freshness-ceilings-ms": {
    "exploration": 86400000,
    "offer": 300000,
    "preview_capture": 60000,
    "seller": 86400000,
    "certificate": 86400000,
    "fx": 900000,
    "quote_and_approval": 300000
  },
  "x-expiry-rule": "eligible iff now < expires_at; every lower provider/evidence ceiling wins",
  "x-idempotency-unique-fields": [
    "tenant",
    "app",
    "user",
    "task",
    "operation_type",
    "request_id"
  ],
  "x-payload-hash-in-key": false
}
