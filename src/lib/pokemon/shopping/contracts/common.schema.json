{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shopping.v1/common",
  "title": "Offline shopping common contracts",
  "$defs": {
    "money": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "minor": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,11})$"
        }
      },
      "required": [
        "currency",
        "minor"
      ]
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "printing_ref": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$"
        },
        "language": {
          "enum": [
            "en",
            "ja"
          ]
        },
        "finish": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "grade_kind": {
          "enum": [
            "slab",
            "raw"
          ]
        },
        "grade_company": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            {
              "type": "null"
            }
          ]
        },
        "grade_value": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            {
              "type": "null"
            }
          ]
        },
        "condition_bucket": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "quantity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "budget_minor": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,11})$"
        },
        "budget_basis": {
          "enum": [
            "item",
            "delivered"
          ]
        },
        "destination_ref": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$"
        },
        "route": {
          "enum": [
            "direct",
            "forwarder"
          ]
        }
      },
      "required": [
        "printing_ref",
        "language",
        "finish",
        "grade_kind",
        "grade_company",
        "grade_value",
        "condition_bucket",
        "quantity",
        "currency",
        "budget_minor",
        "budget_basis",
        "destination_ref",
        "route"
      ]
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,159}$"
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "printing_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            {
              "type": "null"
            }
          ]
        },
        "language": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            {
              "type": "null"
