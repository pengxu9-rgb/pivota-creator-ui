{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shopping.v1/create_checkout_session",
  "title": "create_checkout_session",
  "description": "",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "task_ref": {
      "type": "string",
